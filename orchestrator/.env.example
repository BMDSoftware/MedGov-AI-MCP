# ─────────────────────────────────────────────
# LLM Backend
# ─────────────────────────────────────────────

# Choose between "gemini" (cloud) or "ollama" (local)
LLM_BACKEND=gemini

# Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────
# Ollama (only needed if LLM_BACKEND=ollama)
# ─────────────────────────────────────────────

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ─────────────────────────────────────────────
# FHIR Server (optional)
# ─────────────────────────────────────────────

# URL of the FHIR MCP server (e.g. HAPI FHIR)
FHIR_SERVER_URL=http://localhost:8000/mcp

# ─────────────────────────────────────────────
# Paths
# ─────────────────────────────────────────────

# Absolute path to the repo root — used to expand ${APP_ROOT} in mcp-config.json
APP_ROOT=/absolute/path/to/AgenticHealthMCP
