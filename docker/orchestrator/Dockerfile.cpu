FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    curl \
    g++ \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# -- Copy all requirements first (cache-friendly) -------------------------------------------------------------------------------
COPY mcp-monai/requirements.txt mcp-monai/requirements.txt
COPY mcp-radlex/requirements.txt mcp-radlex/requirements.txt
COPY mcp-utils/requirements.txt mcp-utils/requirements.txt
COPY mcp-ipath/requirements.txt mcp-ipath/requirements.txt
COPY mcp-cellpose/requirements.txt mcp-cellpose/requirements.txt
COPY mcp-pubmed/requirements.txt mcp-pubmed/requirements.txt
COPY mcp-hpo/requirements.txt mcp-hpo/requirements.txt
COPY mcp-calculator/requirements.txt mcp-calculator/requirements.txt
COPY orchestrator/requirements.txt orchestrator/requirements.txt

# -- Install all dependencies -------------------------------------------------------------------------------────────────────────
RUN python -m venv mcp-monai/venv \
    && mcp-monai/venv/bin/pip install --upgrade pip \
    && mcp-monai/venv/bin/pip install --extra-index-url https://download.pytorch.org/whl/cpu \
       -r mcp-monai/requirements.txt

RUN python -m venv mcp-radlex/venv \
    && mcp-radlex/venv/bin/pip install --upgrade pip \
    && mcp-radlex/venv/bin/pip install -r mcp-radlex/requirements.txt

RUN python -m venv mcp-utils/venv \
    && mcp-utils/venv/bin/pip install --upgrade pip \
    && mcp-utils/venv/bin/pip install -r mcp-utils/requirements.txt

RUN python -m venv mcp-ipath/venv \
    && mcp-ipath/venv/bin/pip install --upgrade pip \
    && mcp-ipath/venv/bin/pip install -r mcp-ipath/requirements.txt

RUN python -m venv mcp-cellpose/venv \
    && mcp-cellpose/venv/bin/pip install --upgrade pip \
    && mcp-cellpose/venv/bin/pip install --extra-index-url https://download.pytorch.org/whl/cpu \
       "torch==2.11.0" torchvision \
    && mcp-cellpose/venv/bin/pip install -r mcp-cellpose/requirements.txt

# Pre-download cpsam (the only model in cellpose v4) so first inference isn't slow
RUN mcp-cellpose/venv/bin/python -c "from cellpose import models; models.CellposeModel(gpu=False)"

RUN python -m venv mcp-pubmed/venv \
    && mcp-pubmed/venv/bin/pip install --upgrade pip \
    && mcp-pubmed/venv/bin/pip install -r mcp-pubmed/requirements.txt

RUN python -m venv mcp-hpo/venv \
    && mcp-hpo/venv/bin/pip install --upgrade pip \
    && mcp-hpo/venv/bin/pip install -r mcp-hpo/requirements.txt

RUN python -m venv mcp-calculator/venv \
    && mcp-calculator/venv/bin/pip install --upgrade pip \
    && mcp-calculator/venv/bin/pip install -r mcp-calculator/requirements.txt

RUN python -m venv orchestrator/venv \
    && orchestrator/venv/bin/pip install --upgrade pip \
    && orchestrator/venv/bin/pip install -r orchestrator/requirements.txt

# -- Copy source files (changes here won't invalidate dep layers above) --------
COPY mcp-monai/ mcp-monai/
COPY mcp-radlex/ mcp-radlex/
COPY mcp-utils/ mcp-utils/
COPY mcp-ipath/ mcp-ipath/
COPY mcp-cellpose/ mcp-cellpose/
COPY mcp-pubmed/ mcp-pubmed/
COPY mcp-hpo/ mcp-hpo/
COPY mcp-calculator/ mcp-calculator/
COPY mcp-ct-gov/ mcp-ct-gov/
COPY mcp-fda/ mcp-fda/
COPY mcp-nlm-codes/ mcp-nlm-codes/
COPY orchestrator/ orchestrator/

COPY test_data/ROI_TEST_IMAGE.jpeg test_data/ROI_TEST_IMAGE.jpeg

RUN cd mcp-ct-gov && npm ci && npm run build
RUN cd mcp-fda && npm ci && npm run build
RUN cd mcp-nlm-codes && npm ci && npm run build

# mcp-config.json is gitignored (machine-specific); use the example as the in-image default
RUN cp orchestrator/mcp-config.json.example orchestrator/mcp-config.json

COPY docker/orchestrator/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV APP_ROOT=/app

EXPOSE 5001

ENTRYPOINT ["/entrypoint.sh"]
CMD ["orchestrator/venv/bin/python", "orchestrator/backend.py"]
