# ─────────────────────────────────────────────
# Auth / Security  (REQUIRED for deployment)
# ─────────────────────────────────────────────

# Secret key used to sign JWT tokens — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the default value in production.
JWT_SECRET_KEY=change-me-generate-a-random-64-char-hex-string

# Comma-separated list of allowed frontend origins for CORS.
# In production set this to your actual domain, e.g.:
#   CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Leave empty to only allow localhost (dev default).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,http://localhost:80

# ─────────────────────────────────────────────
# LLM Backend
# ─────────────────────────────────────────────

# Choose between "gemini" (cloud) or "ollama" (local)
LLM_BACKEND=gemini

# Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────
# Ollama (only needed if LLM_BACKEND=ollama)
# ─────────────────────────────────────────────

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ─────────────────────────────────────────────
# FHIR Server (optional)
# ─────────────────────────────────────────────

# URL of the FHIR MCP server (e.g. HAPI FHIR)
FHIR_SERVER_URL=http://localhost:8000/mcp

# ─────────────────────────────────────────────
# Paths
# ─────────────────────────────────────────────

# Absolute path to the repo root — used to expand ${APP_ROOT} in mcp-config.json
APP_ROOT=/absolute/path/to/AgenticHealthMCP

# Root directory for auto-generated workspace folders (writable).
# In Docker this defaults to /app/workspaces (the mounted volume).
# For local development, set this to the orchestrator/workspaces directory:
# WORKSPACES_ROOT=/absolute/path/to/AgenticHealthMCP/orchestrator/workspaces
