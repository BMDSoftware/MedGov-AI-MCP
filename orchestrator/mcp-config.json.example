{
  "mcpServers": {
    "monai": {
      "command": "${APP_ROOT}/mcp-monai/venv/bin/python",
      "args": ["${APP_ROOT}/mcp-monai/server.py"],
      "transport": "stdio",
      "env": {
        "PYTHONUNBUFFERED": "1",
        "OMP_NUM_THREADS": "1",
        "MKL_NUM_THREADS": "1",
        "PYTHONFAULTHANDLER": "1"
      }
    },
    "radlex": {
      "command": "${APP_ROOT}/mcp-radlex/venv/bin/python",
      "args": ["${APP_ROOT}/mcp-radlex/server.py"],
      "transport": "stdio",
      "env": {
        "PYTHONUNBUFFERED": "1",
        "RAD_TEMPLATES_DIR": "${APP_ROOT}/mcp-radlex/templates"
      }
    },
    "utils": {
      "command": "${APP_ROOT}/mcp-utils/venv/bin/python",
      "args": ["${APP_ROOT}/mcp-utils/server.py"],
      "transport": "stdio",
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "fhir": {
      "transport": "http",
      "url": "http://localhost:8000/mcp"
    },
    "cellpose": {
      "command": "${APP_ROOT}/mcp-cellpose/venv/bin/python",
      "args": ["${APP_ROOT}/mcp-cellpose/server.py"],
      "transport": "stdio",
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "ipath": {
      "command": "${APP_ROOT}/mcp-ipath/venv/bin/python",
      "args": ["${APP_ROOT}/mcp-ipath/server.py"],
      "transport": "stdio",
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "pubmed": {
      "command": "${APP_ROOT}/mcp-pubmed/venv/bin/python",
      "args": ["${APP_ROOT}/mcp-pubmed/server.py"],
      "transport": "stdio",
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "hpo": {
      "command": "${APP_ROOT}/mcp-hpo/venv/bin/python",
      "args": ["${APP_ROOT}/mcp-hpo/server.py"],
      "transport": "stdio",
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "clinicaltrials": {
      "command": "node",
      "args": ["${APP_ROOT}/mcp-ct-gov/build/index.js"],
      "transport": "stdio"
    },
    "fda": {
      "command": "node",
      "args": ["${APP_ROOT}/mcp-fda/build/index.js"],
      "transport": "stdio"
    },
    "nlm-codes": {
      "command": "node",
      "args": ["${APP_ROOT}/mcp-nlm-codes/build/index.js"],
      "transport": "stdio"
    },
    "calculator": {
      "command": "${APP_ROOT}/mcp-calculator/venv/bin/python",
      "args": ["${APP_ROOT}/mcp-calculator/api_server.py"],
      "transport": "stdio",
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
